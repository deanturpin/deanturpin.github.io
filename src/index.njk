    <ul class="repos">
      {%- for repo in activeDev %}
      <li>
        <a class="status {{ repo.status }}" href="{{ repo.githubUrl }}{% if repo.status != 'none' %}/actions{% endif %}"
           title="{{ 'Build passing' if repo.status == 'success' else ('Build failing' if repo.status == 'failure' else 'No workflow') }}">
          <span class="visually-hidden">{{ 'Build passing' if repo.status == 'success' else ('Build failing' if repo.status == 'failure' else 'No workflow') }}</span>
        </a>
        <a class="repo-name" href="{{ repo.url }}">{{ repo.name }}</a>
        <span class="repo-desc">{{ repo.description }}</span>
        <time class="repo-time" datetime="{{ repo.updated }}">{{ repo.updated | shortDate }}</time>
      </li>
      {%- endfor %}
    </ul>
  </section>

